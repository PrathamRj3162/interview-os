# ── Required: Supabase (free plan) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used solely for account deletion. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AI providers (configure at least one; all have free tiers) ────
# Tried in this order; on error/rate-limit the next one is used.
AI_PROVIDER_ORDER=gemini,groq,openrouter,ollama
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest   # tried left to right
GROQ_API_KEY=              # https://console.groq.com/keys
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=        # optional
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free   # comma list; only ":free" ids are ever used
OLLAMA_BASE_URL=           # optional self-hosted, e.g. http://localhost:11434
OLLAMA_MODEL=llama3.1

# Fair-use limits
AI_DAILY_REQUEST_LIMIT=60
AI_TIMEOUT_MS=45000
